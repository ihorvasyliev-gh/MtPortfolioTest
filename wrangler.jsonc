{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariia-troian",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "mtportfolio-photos" }
  ]
  // Optional: serve photos straight from an R2 custom domain (faster, no Function hit per image):
  // "vars": { "IMG_BASE": "https://photos.example.com" }
}
